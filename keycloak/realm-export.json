{
  "realm": "k8s-realm",
  "enabled": true,
  "displayName": "Kubernetes OIDC Realm",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "project-owner", "description": "Can grant developer access" },
      { "name": "developer", "description": "Standard developer access" }
    ]
  },
  "groups": [
    { "name": "dev-team-alpha", "path": "/dev-team-alpha" }
  ],
  "clients": [
    {
      "clientId": "kubernetes",
      "name": "Kubernetes API Server OIDC",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:18000",
        "http://127.0.0.1:18000"
      ],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"]
    },
    {
      "clientId": "kubeauth-backend",
      "name": "KubeAuth Backend Service Account",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "kubeauth-super-secret-key-12345",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "alice.owner",
      "enabled": true,
      "email": "alice@company.local",
      "firstName": "Alice",
      "lastName": "Owner",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["project-owner"],
      "groups": ["/dev-team-alpha"]
    },
    {
      "username": "bob.dev",
      "enabled": true,
      "email": "bob@company.local",
      "firstName": "Bob",
      "lastName": "Developer",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["developer"],
      "groups": ["/dev-team-alpha"]
    },
    {
      "username": "charlie.intern",
      "enabled": true,
      "email": "charlie@company.local",
      "firstName": "Charlie",
      "lastName": "Intern",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }]
    }
  ]
}
